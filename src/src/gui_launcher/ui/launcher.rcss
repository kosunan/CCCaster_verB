/* RmlUi 6.3用。フォント、配色、寸法はアプリに同梱して固定する。 */
body { width:100%; height:100%; margin:0; font-family:Launcher; font-size:14dp; line-height:1.65; word-break:break-word; color:#f1f3fc; background-color:#04060d; }
div, p, section, nav, main, header, footer, article, h1, h2, h3, fieldset, details { display:block; }
* { box-sizing:border-box; }
/* 黒いメニュー面の後ろに、ゲーム本編の円弧と縦の意匠を図形で添える。 */
.menu-backdrop { position:absolute; left:0; right:0; top:0; bottom:0; overflow:hidden; pointer-events:none; }
.backdrop-orbit { position:absolute; width:730dp; height:730dp; top:-320dp; right:-270dp; border:26dp #111c40; border-radius:365dp; }
.backdrop-orbit-inner { position:absolute; left:35dp; top:35dp; width:608dp; height:608dp; border:2dp #273968; border-radius:304dp; }
.backdrop-pillar { position:absolute; bottom:0; width:6dp; background-color:#152349; }
.pillar-one { right:32dp; height:64%; width:2dp; }
.pillar-two { right:48dp; height:59%; width:10dp; }
.pillar-three { right:65dp; height:53%; width:3dp; }
.pillar-four { right:92dp; height:46%; width:14dp; }
.pillar-five { right:124dp; height:34%; width:4dp; }
.backdrop-floor { position:absolute; bottom:-60dp; right:90dp; width:430dp; height:120dp; border-top:2dp #263560; background-color:#0c142c; transform:skewX(-35deg); }
.hidden { display:none; }
button, summary { display:inline-block; tab-index:auto; cursor:pointer; background-color:#111b31; color:#f1f3fc; border:1dp #344471; border-radius:0; padding:9dp 14dp; }
button:hover, summary:hover { background-color:#26355b; }
button:focus, input:focus, select:focus, textarea:focus, summary:focus { border-color:#c6d7ff; }
button:disabled, input:disabled, select:disabled { opacity:0.45; cursor:unavailable; }
button.primary { background-color:#991529; border-color:#d7394c; font-weight:bold; padding:12dp 22dp; margin-top:16dp; }
button.primary:hover { background-color:#bd2035; }
button.quiet { background-color:#0c1222; }
.masthead { height:94dp; padding:14dp 22dp; display:flex; align-items:center; justify-content:space-between; gap:20dp; background-color:#03050b; border-bottom:1dp #6550c6; }
.masthead { position:relative; overflow:hidden; }
.brand { display:flex; align-items:center; position:relative; flex-shrink:0; }
.brand-mark { display:none; }
.brand h1 { font-size:29dp; line-height:1.3; margin:0; font-weight:bold; letter-spacing:2dp; transform:skewX(-10deg); }
.brand h1 span { color:#afbfef; font-size:17dp; margin-left:4dp; }
.brand p { font-size:10dp; color:#8d9bbf; margin:6dp 0 0; }
.version { flex-shrink:0; font-size:11dp; color:#acb9de; background-color:#0a1020; padding:5dp 10dp; border-radius:0; }
.shell { position:absolute; top:94dp; bottom:0; left:0; right:0; display:flex; }
nav { width:202dp; flex-shrink:0; height:100%; padding:22dp 10dp 16dp; background-color:#050812; border-right:1dp #293555; overflow-y:auto; }
#nav-guide { margin-top:20dp; }
.menu-title { font-size:13dp; font-weight:bold; letter-spacing:2dp; padding:0 12dp 12dp; margin-bottom:18dp; border-bottom:1dp #5742b0; transform:skewX(-8deg); }
.nav-item { display:block; width:100%; text-align:left; border:1dp transparent; margin-bottom:6dp; background-color:transparent; padding:12dp 10dp; font-size:13dp; }
.nav-number { display:none; }
.nav-label { display:inline-block; font-weight:bold; letter-spacing:1dp; transform:skewX(-8deg); }
.nav-item:hover { background-color:#741225; }
.nav-item.active { background-color:#a01528; border-color:#de3549; color:#ffffff; }
.nav-bottom { padding:28dp 10dp 0; }
main { flex:1; height:100%; padding:24dp 25dp 12dp; overflow-y:auto; min-width:0; }
h2 { font-size:27dp; font-weight:bold; margin:0; }
h3 { font-size:15dp; font-weight:bold; margin:0 0 12dp; }
p { line-height:1.8; margin:10dp 0; }
.page-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:22dp; }
.settings-heading { flex-wrap:wrap; gap:12dp; }
#settings-back { font-size:12dp; padding:8dp 12dp; }
.pill { font-size:10dp; color:#becbe8; background-color:#0e172d; border:1dp #304164; border-radius:4dp; padding:4dp 8dp; }
.tabs { display:flex; border-bottom:1dp #293555; margin-bottom:18dp; }
.tabs button { border:0; border-bottom:2dp transparent; border-radius:0; background-color:#04060d; color:#9facce; padding:10dp 12dp; }
.tabs button.active { border-bottom-color:#e9384c; color:#ffffff; }
.card { background-color:#090f1eee; border:1dp #293555; border-radius:0; padding:18dp 20dp; margin-bottom:16dp; }
/* 起動ボタンはページの外に置き、全画面共通のヘッダーへ横並びで常設する。 */
.header-actions { display:flex; flex:1; min-width:0; max-width:660dp; gap:10dp; }
.mode-launch { display:flex; position:relative; flex:1; min-width:0; height:64dp; padding:10dp 12dp; align-items:center; gap:10dp; border:1dp #28355b; border-bottom:2dp #6550c6; border-radius:0; background-color:#080e1c; }
.mode-launch:hover { background-color:#110c19; }
.mode-launch:focus { border-color:#ffffff; background-color:#0d0c18; }
.menu-selection { display:block; position:absolute; left:0; right:0; top:10dp; height:24dp; background-color:transparent; }
.mode-launch:hover .menu-selection { background-color:#5c1123; }
.mode-launch:focus .menu-selection { background-color:#a8172b; }
.mode-launch:active .menu-selection { background-color:#cd243e; }
.mode-copy { display:block; position:relative; flex:1; min-width:0; text-align:left; }
.mode-title { display:block; font-size:18dp; line-height:1.25; font-weight:bold; letter-spacing:1dp; color:#ffffff; transform:skewX(-10deg); }
.mode-label { display:block; font-size:10dp; color:#ccd4e8; margin-top:4dp; }
.mode-icon { display:block; position:relative; width:36dp; height:36dp; flex-shrink:0; }
.mode-icon span { display:block; position:absolute; }
.target-icon { border:2dp #dce5ff; border-radius:18dp; }
.target-ring { left:6dp; top:6dp; width:20dp; height:20dp; border:2dp #dce5ff; border-radius:10dp; }
.target-center { left:5dp; top:5dp; width:6dp; height:6dp; border-radius:3dp; background-color:#dce5ff; }
.pad { width:25dp; height:18dp; border:2dp #dce5ff; border-radius:5dp; background-color:#10182e; }
.pad-one { left:0; top:2dp; }
.pad-two { right:0; bottom:2dp; }
.pad-cross-h { left:2dp; top:6dp; width:7dp; height:2dp; background-color:#dce5ff; }
.pad-cross-v { left:5dp; top:3dp; width:2dp; height:8dp; background-color:#dce5ff; }
.pad-dot { width:2dp; height:2dp; border-radius:1dp; background-color:#dce5ff; }
.dot-one { right:2dp; top:3dp; }
.dot-two { right:5dp; top:7dp; }
.replay-screen { left:0; top:4dp; width:36dp; height:28dp; border:2dp #dce5ff; border-radius:3dp; }
.replay-play { left:12dp; top:4dp; width:0; height:0; border-top:5dp transparent; border-bottom:5dp transparent; border-left:8dp #dce5ff; }
.replay-progress { left:4dp; right:4dp; bottom:3dp; height:2dp; background-color:#dce5ff; }
@media (max-width:960dp) {
    .masthead { padding:14dp; gap:14dp; }
    .brand h1 { font-size:22dp; letter-spacing:1dp; }
    .brand h1 span { font-size:13dp; }
    .brand p, .version { display:none; }
    .header-actions { gap:8dp; }
    .mode-launch { padding:10dp 8dp; gap:8dp; }
    .mode-title { font-size:15dp; }
}
@media (max-width:620dp) {
    .masthead { height:126dp; flex-direction:column; align-items:stretch; padding:10dp; gap:10dp; }
    .brand h1 { font-size:20dp; }
    .header-actions { width:100%; gap:6dp; }
    .mode-launch { padding:10dp 6dp; gap:6dp; }
    .mode-title { font-size:13dp; letter-spacing:0; }
    .mode-label { font-size:9dp; }
    .shell { top:126dp; }
}
.registration { border-top:2dp #6550c6; }
.card-title, .list-heading { display:flex; align-items:center; justify-content:space-between; }
.card-title { margin-bottom:12dp; }
.card-title h3 { margin:0; }
.card-title .subtle { font-size:11dp; text-align:right; }
.subtle { color:#aebbd8; font-size:12dp; }
.row { display:flex; align-items:flex-end; flex-wrap:wrap; }
.row > * { margin-right:12dp; }
.grow { flex:1; min-width:120dp; }
.port { width:135dp; }
label { display:block; margin:12dp 0; }
label > span { display:block; font-size:12dp; color:#c6d1eb; margin-bottom:7dp; }
input, select, textarea { display:block; width:100%; tab-index:auto; color:#f1f3fc; background-color:#03060f; border:1dp #394c78; padding:10dp 12dp; border-radius:0; min-width:0; }
input { height:43dp; cursor:text; }
select { height:43dp; cursor:pointer; padding:0; }
select selectvalue { padding:10dp 24dp 10dp 12dp; }
select selectarrow { width:18dp; height:12dp; margin:14dp 7dp; background-color:#899ccd; border-radius:3dp; }
select selectbox { background-color:#0b1224; border:1dp #647da8; max-height:240dp; overflow-y:auto; }
select option { display:block; padding:10dp 12dp; }
select option:hover, select option:checked { background-color:#84182a; }
textarea { height:100dp; overflow-y:auto; cursor:text; }
.check { display:flex; align-items:center; min-height:27dp; }
.check > span { margin:0 0 0 10dp; }
.check input { width:18dp; height:18dp; padding:0; margin:0; cursor:pointer; flex-shrink:0; }
.check input:checked { background-color:#edf2ff; border:4dp #3c5588; }
.code-line { display:flex; align-items:center; flex-wrap:wrap; margin:15dp 0; }
.code-line > * { margin-right:14dp; }
.code { font-size:29dp; letter-spacing:5dp; color:#f0f4ff; word-break:break-all; }
.code-input { letter-spacing:3dp; }
fieldset { padding:0; border:0; margin:0; min-width:0; }
details { margin-top:16dp; }
summary { font-size:12dp; padding:6dp 10dp; }
details > * { display:none; }
details > summary { display:inline-block; }
details.open > * { display:block; }
.feature { padding:26dp; }
.feature h3 { font-size:22dp; color:#eff4ff; }
.feature > p { color:#b4c1dc; }
.tips { margin-top:25dp; }
.tips p { padding:12dp 0; border-bottom:1dp #212d4a; font-size:12dp; margin:0; color:#aebbd8; }
kbd { display:inline-block; font-weight:bold; font-size:11dp; min-width:105dp; color:#d7e2ff; }
.notice { padding:15dp 18dp; border:1dp #795d39; background-color:#37261d; border-radius:0; margin-bottom:18dp; font-size:13dp; }
.notice.incoming { border-color:#987344; background-color:#32251c; }
.notice p { font-size:12dp; margin:4dp 0 10dp; }
.notice.error { background-color:#3c101b; border-color:#c93048; }
.error-text { color:#ffb4be; font-size:12dp; }
.request-card { border-color:#9c7454; }
.request, .person { padding:15dp 0; border-bottom:1dp #293555; }
.person { background-color:#080f1f; border:1dp #293555; border-radius:0; padding:15dp 17dp; margin:8dp 0; display:flex; justify-content:space-between; align-items:center; }
.person-content { min-width:0; flex:1; }
.person strong, .request strong { font-size:14dp; word-break:break-all; }
.person p, .request p { margin:5dp 0; font-size:12dp; word-break:break-all; }
.person-actions { margin-left:12dp; flex-shrink:0; }
.person-actions button { font-size:11dp; padding:7dp 10dp; margin-left:6dp; }
.request-actions { margin-top:9dp; }
.request-actions button { margin-right:8dp; }
.list-heading { margin:26dp 0 12dp; }
.list-heading h3 { margin:0; }
.list-heading p { margin:5dp 0 0; }
.pagination { display:flex; align-items:center; justify-content:center; margin:16dp 0 25dp; font-size:12dp; color:#aebbd8; }
.pagination > * { margin:0 9dp; }
.empty { text-align:center; padding:30dp 15dp; background-color:#080e1b; border:1dp #293b60; border-radius:0; color:#a0afd1; font-size:12dp; }
.session-card { border-left:3dp #7f98d9; margin-top:23dp; }
.session-card.failed { border-left-color:#ee4158; }
.log-details { border-top:1dp #212d4a; padding-top:10dp; margin-top:24dp; }
pre { display:block; white-space:pre-wrap; word-break:break-all; font-size:11dp; line-height:1.7; max-height:250dp; overflow-y:auto; background-color:#02040a; padding:12dp; border-radius:5dp; color:#a9badb; }
#emblem { box-sizing:content-box; flex-shrink:0; width:96dp; height:48dp; background-color:#0e182d; border:1dp #344975; border-radius:0; }
scrollbarvertical { width:12dp; margin:2dp; }
scrollbarvertical slidertrack { background-color:#060b15; }
scrollbarvertical sliderbar { background-color:#32456e; min-height:24dp; border-radius:5dp; }
scrollbarvertical sliderbar:hover { background-color:#647fb6; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height:0; }
scrollbarhorizontal { height:12dp; }
scrollbarhorizontal sliderbar { background-color:#32456e; min-width:24dp; }
selection { background-color:#a61a31; color:white; }
@media (max-width:820dp) { nav { width:164dp; } main { padding:20dp 16dp; } .nav-item { font-size:12dp; } .nav-number { display:none; } .person { display:block; } .person-actions { margin:10dp 0 0; } .version { display:none; } .card-title { flex-wrap:wrap; } }
@media (max-width:620dp) { nav { width:126dp; padding:18dp 6dp; } .nav-item { font-size:11dp; padding:9dp 6dp; }  .card { padding:14dp; } main { padding:16dp 12dp; } h2 { font-size:22dp; } .tabs { display:block; } .port { width:110dp; } .brand-mark { display:none; } }
/* マッチングは一覧と自分の待機操作を同じ視線内に置く。 */
#page-matching { max-width:1240dp; }
.matching-heading { margin-bottom:14dp; }
.matching-heading h2 { font-size:25dp; line-height:1.3; }
.matching-heading p.subtle { margin:6dp 0 0; }
.matching-tabs { padding:4dp; background-color:#060a14; border:1dp #293555; border-radius:0; margin-bottom:16dp; flex-wrap:wrap; }
.matching-tabs button { background-color:#060a14; border:1dp transparent; border-radius:0; padding:10dp 16dp; font-size:12dp; }
.matching-tabs button.active { background-color:#961729; border-color:#d13045; color:#ffffff; }
.matching-layout { display:flex; align-items:flex-start; gap:16dp; }
.directory-card { flex:1; min-width:0; }
.directory-card { padding:0; overflow:hidden; }
.directory-heading { padding:12dp 18dp 10dp; border-bottom:1dp #2d3a5b; }
.directory-heading .card-title { margin:4dp 0 10dp; }
.directory-heading h3 { font-size:18dp; }
.count-badge { font-size:12dp; font-weight:bold; background-color:#1e2d50; color:#dbe7ff; padding:3dp 9dp; border-radius:5dp; margin-left:8dp; }
.directory-status { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; }
.people-window { min-height:144dp; padding:8dp; background-color:#070d1a; }
#people { display:flex; flex-wrap:wrap; align-content:flex-start; width:100%; }
.player-row { display:flex; align-items:center; gap:5dp; flex:1 0 196dp; height:32dp; text-align:left; font-size:13dp; line-height:18dp; padding:6dp; margin:0; border:1dp #253250; border-radius:0; background-color:#070d1a; color:#f0f4ff; overflow:hidden; }
.player-name { display:block; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.player-age { display:block; flex-shrink:0; font-size:10dp; color:#a9b6d5; white-space:nowrap; }
.player-row:hover { background-color:#182b4a; }
.player-row.selected { background-color:#77152a; border-color:#ce3048; }
.player-row.own { border-color:#ce3048; }
.player-meta { display:block; flex-shrink:0; text-align:right; }
.player-self { display:block; font-size:8dp; line-height:8dp; color:#d1deff; }
.player-meta .player-age { line-height:10dp; }
#retry-cleanup { width:100%; margin-top:12dp; font-size:11dp; }
.player-selection { padding:0 16dp 14dp; }
.player-selection p { margin:0 0 8dp; word-break:break-all; }
.selection-actions { display:flex; flex-wrap:wrap; }
.selection-actions button { font-size:11dp; padding:7dp 12dp; margin:0 8dp 4dp 0; }
#invite-selected { background-color:#8c1a30; border-color:#c43950; }
.directory-card .pagination { margin:0; padding:12dp; border-top:1dp #293555; }
.directory-card .pagination button { padding:6dp 12dp; font-size:11dp; }
.directory-note { margin:0; padding:0 16dp 14dp; color:#98a8cc; font-size:10dp; }
.directory-card #incomplete { padding:0 16dp; }
.directory-card .empty { width:100%; border:0; background-color:#070d1a; padding:20dp 12dp; }
.directory-card .empty strong { font-size:14dp; color:#cdd9ef; }
.directory-card .empty p { font-size:12dp; }
.matching-layout .registration { width:320dp; flex-shrink:0; padding:16dp; border-top:3dp #dd2b45; background-color:#0d162a; }
.registration h3 { font-size:18dp; margin:6dp 0 16dp; }
.standby-profile { display:flex; align-items:center; padding-bottom:14dp; margin-bottom:14dp; border-bottom:1dp #34436b; }
.standby-profile-details { flex:1; min-width:0; }
.profile-name-row { display:flex; align-items:center; gap:8dp; }
.profile-name-row strong { flex:1; min-width:0; }
#profile-settings { flex-shrink:0; font-size:11dp; line-height:18dp; padding:5dp 7dp; white-space:nowrap; }
.standby-profile strong { font-size:14dp; word-break:break-all; }
.standby-profile p { margin:3dp 0 0; font-size:11dp; }
.profile-mark { display:flex; align-items:center; justify-content:center; width:50dp; height:30dp; flex-shrink:0; margin-right:10dp; border:1dp #6582bc; border-radius:3dp; color:#d1dcf4; background-color:#203053; font-weight:bold; }
#matching-emblem { width:48dp; height:24dp; flex-shrink:0; }
.registration .standby-start { display:block; width:100%; padding:12dp 5dp; margin-top:14dp; font-size:12dp; }
.registration .code { font-size:23dp; letter-spacing:3dp; }
.registration .code-line { display:block; }
.registration .code-line button { margin-top:8dp; font-size:11dp; }
.registration .standby-switch, .registration .standby-stop { display:block; width:100%; font-size:11dp; margin-top:10dp; }
.registration .standby-switch { border-color:#8b9fca; background-color:#273b65; }
@media (max-width:940dp) { .matching-tabs button { padding:9dp 11dp; } .player-row { padding:6dp 4dp; } }
@media (max-width:820dp) { .matching-layout { flex-direction:column; gap:0; } .directory-card, .matching-layout .registration { flex:none; width:100%; } }
/* 状態による非表示はレイアウト指定よりも優先する。 */
#page-controller { max-width:870dp; }
#page-controller .page-heading { margin-bottom:4dp; }
#controller-game-hint { font-size:11dp; margin:0 0 18dp; }
.controller-card .row { gap:8dp; align-items:center; }
.controller-card .row > * { margin-right:0; }
.controller-card .grow { min-width:180dp; }
#controller-refresh { font-size:11dp; }
#controller-bindings { display:flex; flex-wrap:wrap; gap:0 20dp; }
.binding-row { display:flex; align-items:center; gap:8dp; width:100%; border-bottom:1dp #293555; padding:7dp 0; }
.binding-label { flex:1; min-width:0; font-size:12dp; }
.binding-value { width:210dp; padding:6dp 10dp; font-size:12dp; }
.binding-clear { font-size:11dp; padding:6dp 9dp; }
.binding-value.capturing { background-color:#84182a; border-color:#c6d7ff; }
.controller-feedback { margin-top:12dp; }
@media (max-width:820dp) { .binding-value { width:145dp; } }
@media (max-width:620dp) { .binding-row { flex-wrap:wrap; } .binding-label { width:100%; flex:auto; } .binding-value { flex:1; } }
.hidden, details.open > .hidden { display:none; }
.registration .standby-switch.hidden { display:none; }

#emblem-presets { display:flex; flex-wrap:wrap; gap:6dp; }
.emblem-preset { display:flex; align-items:center; width:156dp; gap:8dp; padding:7dp; font-size:12dp; }
.emblem-preset img { width:48dp; height:24dp; }
